# Server environment variables example
# Copy this file to `.env` and replace the placeholder values.

# Port the server listens on (Render sets this automatically)
PORT=10000

# Node environment
NODE_ENV=production

# MongoDB connection string
MONGODB_URI=this is some mongo database

# Secret used to sign JWT tokens (use a long random string)
JWT_SECRET=replace-with-a-long-random-secret-string

# JWT expiration time
JWT_EXPIRE=24h

# Allowed CORS origin (frontend URL)
CORS_ORIGIN=https://multi-tenants-deployment.vercel.app

# Allowed Socket.IO origin (frontend URL)
SOCKET_ORIGIN=https://multi-tenants-deployment.vercel.app
